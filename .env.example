# =========================
# Database (Oracle)
# =========================
# DB_USERNAME / DB_PASSWORD provision the Oracle XE container itself
# (docker-compose.yml derives ORACLE_USERNAME/ORACLE_PASSWORD for the app
# service from these two automatically - keep the values identical below).
DB_USERNAME=immigration_db
DB_PASSWORD=your_secure_password

# Read directly by the Spring Boot app (application.yml). Required when
# running outside docker-compose (e.g. `mvnw spring-boot:run`), since Spring
# Boot does not load this .env file itself - only docker-compose does.
# When running via docker-compose, leave these as-is; they are overridden
# with DB_USERNAME/DB_PASSWORD and the in-network Oracle hostname.
ORACLE_DATABASE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=immigration_db
ORACLE_PASSWORD=your_secure_password

# Optional Hikari overrides
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=20000
DB_MAX_LIFETIME=1800000
DB_VALIDATION_TIMEOUT=5000
DB_LEAK_DETECTION=20000
ORACLE_CONNECT_TIMEOUT=10000
ORACLE_READ_TIMEOUT=30000

# =========================
# Flyway
# =========================
# Leave unset/false normally. Only set to true for a one-time catch-up
# deploy - see src/main/resources/db/migration/README.md.
FLYWAY_OUT_OF_ORDER=false

# =========================
# JWT
# =========================
# Must be at least 32 bytes. Generate with, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_random_32_byte_or_longer_secret
JWT_EXPIRATION=3600000

# =========================
# Initial administrator bootstrap
# =========================
# Used once, on first startup, to create the sole ADMIN account.
# Password must be at least 12 characters.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_this_password_now

# =========================
# Mail (SMTP)
# =========================
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_app_password

# =========================
# OpenAI / Spring AI
# =========================
OPENAI_API_KEY=your_openai_api_key

# =========================
# OCR
# =========================
TESSDATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
OCR_LANGUAGE=eng

# =========================
# File Storage
# =========================
UPLOAD_DIR=uploads/
DOCUMENT_MAX_FILE_SIZE=10485760

# =========================
# AWS S3
# =========================
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read directly by the AWS SDK's
# DefaultCredentialsProvider - not by Spring - but are listed here since this
# app requires them when no IAM role is available (e.g. local development).
AWS_S3_BUCKET=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=af-south-1

# =========================
# CORS
# =========================
# Comma-separated list of additional allowed origins for production
# frontends. Localhost dev origins are always allowed.
CORS_ALLOWED_ORIGINS=

# =========================
# Spring
# =========================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
