# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================

VITE_APP_NAME=MukondoGTech AI Platform
VITE_APP_VERSION=1.0.0


# ============================================================================
# BACKEND API
# ============================================================================

# Local Spring Boot backend
VITE_API_URL=http://localhost:8080/api


# ============================================================================
# AUTHENTICATION
# ============================================================================

# Current authenticated user's profile
VITE_PROFILE_ENDPOINT=/profile/me

# Logout authenticated user
VITE_LOGOUT_ENDPOINT=/auth/logout


# ============================================================================
# FRONTEND ROUTES
# ============================================================================

VITE_DASHBOARD_ROUTE=/dashboard
VITE_LOGIN_ROUTE=/login

VITE_PROFILE_SETTINGS_ROUTE=/dashboard/profile/settings
VITE_SUBSCRIPTION_ROUTE=/dashboard/subscription
VITE_DOCUMENTS_ROUTE=/dashboard/documents
VITE_REPORTS_ROUTE=/dashboard/reports
VITE_NOTIFICATION_SETTINGS_ROUTE=/dashboard/settings/notifications


# ============================================================================
# FRONTEND FEATURES
# ============================================================================

VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true


# ============================================================================
# AI MONITORING
# ============================================================================

# Enable AI monitoring frontend features
VITE_AI_MONITORING_ENABLED=true

# Base API URL for AI monitoring
VITE_AI_MONITORING_API_URL=http://localhost:8080/api

# Automatically refresh monitoring metrics
VITE_AI_MONITORING_AUTO_REFRESH=true

# Refresh monitoring data every 30 seconds
VITE_AI_MONITORING_REFRESH_INTERVAL_MS=30000

# Maximum AI monitoring API request time
VITE_AI_MONITORING_REQUEST_TIMEOUT_MS=15000